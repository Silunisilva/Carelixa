rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing rules for users/children (allow read/write for authenticated users for now)
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /children/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // IMMUTABLE AUDIT TRAIL RULES
    match /audit_logs/{logId} {
      // Anyone authenticated can read (or restrict this to just doctors/admins if preferred)
      allow read: if request.auth != null;
      
      // APPEND-ONLY: Allow creation if authenticated
      allow create: if request.auth != null;
      
      // DENY ALL updates and deletions
      allow update: if false;
      allow delete: if false;
    }
  }
}
